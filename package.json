{
  "name": "showflow",
  "productName": "ShowFlow",
  "version": "1.0.0",
  "description": "Offline-first live production cueing and display control for the Educational Media Unit, Maris Stella College.",
  "author": {
    "name": "Sandila Fernando"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "electron",
    "live-production",
    "show-caller",
    "cueing",
    "media",
    "offline"
  ],
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "pack": "npm run icons && npm run build:renderer && electron-builder --win --dir",
    "dist": "npm run icons && npm run build:renderer && electron-builder --win nsis portable --publish never",
    "dist:nsis": "npm run icons && npm run build:renderer && electron-builder --win nsis --publish never",
    "dist:portable": "npm run icons && npm run build:renderer && electron-builder --win portable --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:renderer && node tests/e2e/smoke.mjs",
    "test:e2e:packaged": "node tests/e2e/packaged.mjs",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test && npm run build:renderer",
    "icons": "node scripts/generate-icons.mjs",
    "checksums": "node scripts/checksums.mjs",
    "screenshots": "npm run build:renderer && node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "framer-motion": "12.43.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sql.js": "1.15.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "vite": "6.4.5",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
